  "runtimes": [
    {
      "name": "AIOpsAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/AIOpsAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
