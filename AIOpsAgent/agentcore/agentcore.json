      "envVars": [
        { "name": "AIOPS_DRY_RUN",  "value": "true" },
        { "name": "AIOPS_MODEL_ID", "value": "us.amazon.nova-2-lite-v1:0" }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
